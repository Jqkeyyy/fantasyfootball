# fantasyfootball weekly automation.
# Install with: crontab crontab.example
# (edit the `cd` path first to match where the repo actually lives on
# this machine, then re-save before installing.)
#
# Mirrors weekly-refresh.bat's old Windows Task Scheduler cadence.
# Minute/hour (08:00) is a reasonable default, not load-bearing -- the
# scripts themselves resolve the current NFL week live from Sleeper,
# so running an hour or two later than this won't break anything.
# Day-of-week: 0=Sunday, 2=Tuesday, 4=Thursday.
0 8 * * 2 cd /path/to/fantasyfootball && docker compose exec -T app ./weekly-refresh.sh tuesday >> data/outputs/logs/cron.log 2>&1
0 8 * * 4 cd /path/to/fantasyfootball && docker compose exec -T app ./weekly-refresh.sh thursday >> data/outputs/logs/cron.log 2>&1
0 8 * * 0 cd /path/to/fantasyfootball && docker compose exec -T app ./weekly-refresh.sh sunday >> data/outputs/logs/cron.log 2>&1
