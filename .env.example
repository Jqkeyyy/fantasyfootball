FFAPP_OFFLINE=1
FFAPP_CACHE_STRICT=1     # raise on stale cache instead of warning
ODDS_API_KEY=
ANTHROPIC_API_KEY=
# Optional alternative to the private Phone Alerts setup page.
# Server Settings > Integrations > Webhooks; keep the real URL in .env
DISCORD_WEBHOOK_URL=
# Optional: raises GitHub API limits for scheduled refreshes
GITHUB_TOKEN=

# Server deployment only. The safe default is loopback, which is reachable
# through an SSH tunnel. Set this to the host's Tailscale IP for direct
# tailnet access. Do not use 0.0.0.0.
FFAPP_BIND_IP=127.0.0.1

# Private dashboard address used in Discord links and the Install App page,
# e.g. the HTTPS URL printed by `tailscale serve status`.
FFAPP_DASHBOARD_URL=
# Windows launcher only: the home server's SSH address for start-server-app.bat.
FFAPP_SERVER_HOST=
