FFAPP_OFFLINE=1
FFAPP_CACHE_STRICT=1     # raise on stale cache instead of warning
ODDS_API_KEY=
ANTHROPIC_API_KEY=

# Server deployment only (docs/design-server-deployment.md). Set this to
# the host's own Tailscale IP (`tailscale ip -4`) once Tailscale is up --
# docker-compose.yml uses it to scope the published port to the tailnet
# only, never to the public internet or LAN. Leave unset for local/laptop
# use; there is no default, so an unset value here would break the compose
# port mapping if you tried to bring the stack up without it.
TAILSCALE_IP=
